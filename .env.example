# Project-scoped External API key. Obtain via Settings > API Keys > External API.
FACTORY_API_KEY=
FACTORY_PROJECT_ID=111f2375-bea8-4c31-8eb4-dca7f3398144
# Set before exposing the application on any shared/public network (username invariant).
INVARIANT_PASSWORD=
# Default false. WARNING: adapters execute arbitrary Python; trusted local use only.
ALLOW_REPOSITORY_EXECUTION=false
# Optional overrides:
# INVARIANT_PYTHON=/absolute/path/to/python
# INVARIANT_DATA_DIR=/absolute/path/to/persistent/data
