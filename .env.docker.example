# Copied to .env.docker on first script invocation. Never commit .env.docker.
INVARIANT_HOST_PORT=3000
# Optional: built-in demos work without an API key.
FACTORY_API_KEY=
FACTORY_PROJECT_ID=111f2375-bea8-4c31-8eb4-dca7f3398144
# Optional HTTP Basic login: username invariant. Use single quotes if a value contains $.
INVARIANT_PASSWORD=
# Opt in ONLY for reviewed/trusted repositories. Docker is not a hostile-code sandbox.
ALLOW_REPOSITORY_EXECUTION=false
